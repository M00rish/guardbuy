# Copy to .env and fill in. Never commit .env.
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES are set by `shopify app dev` locally.

# Neon (or any) Postgres. DATABASE_URL is pooled, DIRECT_URL is direct (used for migrations).
# Add ?sslmode=require&connect_timeout=30&pool_timeout=30 for Neon.
DATABASE_URL=
DIRECT_URL=

# One PayPal sandbox REST app configured on this server; no per-store credential onboarding.
# Payouts spend its business account balance; Orders spend the explicitly bound approving payer account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   (default)

# Demo supplier: the sandbox PayPal email that receives payouts, and its own app keys
# (used only by scripts/refill-sandbox.ts and to refund in tests)
SUPPLIER_EMAIL=
SUPPLIER_PAYPAL_CLIENT_ID=
SUPPLIER_PAYPAL_CLIENT_SECRET=

# Required when payments are enabled: bind each authorized shop to this PAYPAL_CLIENT_ID
# and to the merchant sandbox payer IDs allowed to fund its Orders. Never use a supplier payer ID.
# Replace every placeholder; empty mappings/lists refuse payments (including local development).
GUARDBUY_PAYPAL_STORES={"your-store.myshopify.com":{"clientId":"replace-with-PAYPAL_CLIENT_ID","payerIds":["REPLACEWITHMERCHANTPAYERID"]}}
# GUARDBUY_APPROVER_PAYER_IDS is obsolete and is not used.

# AI proposer: Gemini first, OpenRouter free models as fallback
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# GUARDBUY_LLM_MODELS=google:gemini-3.8-flash,openrouter:nvidia/nemotron-3-super-120b-a12b:free

# Shared with the hourly scheduler (GitHub Actions secret). At least 24 random characters.
JOBS_SECRET=

# Demo store used by the public dashboard and reset job, e.g. guardbuy-demo.myshopify.com
GUARDBUY_DEMO_STORE=
# Explicit consent to show this demo store’s aggregate activity publicly (sandbox PayPal only).
GUARDBUY_PUBLIC_DEMO_ENABLED=false

# Emergency stop: set to 1 to refuse every payout and capture
# GUARDBUY_PAYMENTS_DISABLED=1

# Durable inventory worker: starts automatically in production; local development requires "on".
# Set "off" to pause queue processing without discarding saved jobs. The payment kill switch still applies.
# GUARDBUY_RESTOCK_WORKER=off

# Public privacy support destination (https:// URL or mailto: address). Required before real merchants.
GUARDBUY_PRIVACY_CONTACT=

# Optional Telegram notifications. Default off; merchant must also pair and confirm in Alerts.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random 32+ character URL-safe secret; also used when registering Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# PayPal item webhooks auto-register at SHOPIFY_APP_URL/paypal/webhook with existing sandbox credentials.
# No webhook ID/key is needed. Optional rollback: GUARDBUY_PAYPAL_WEBHOOKS=off
