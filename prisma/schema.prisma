// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection
  directUrl = env("DIRECT_URL") // Neon direct connection, used by migrations
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Net units sold per product variant per UTC day (sales minus refunds). Only aggregates are stored
// (no order or customer data), and rows older than 90 days are deleted (see app/lib/inventory/sales.server.ts).
// Keyed by Shopify's numeric variant id: SKUs can be blank or shared by several variants.
model DailySales {
  shop      String
  variantId String
  day       DateTime @db.Date
  units     Int

  @@id([shop, variantId, day])
}

// Webhooks Shopify already delivered (it can send the same event more than once). Recorded in the
// same transaction as the sales change, so a duplicate is never counted twice. Pruned after 7 days.
model ProcessedWebhook {
  eventId    String
  topic      String
  shop       String
  receivedAt DateTime @default(now())

  @@id([eventId, topic])
}

// Marks a shop's sales history as fully loaded. Written in the same transaction as the
// DailySales rows, so an interrupted or duplicated backfill never counts as complete.
model SalesBackfill {
  shop        String   @id
  completedAt DateTime
}

// Append-only, hash-chained audit log (one chain per shop). Each entry's hash covers the
// previous entry's hash, so editing or deleting any past row breaks every later hash.
model AuditEntry {
  shop     String
  seq      Int
  at       DateTime
  type     String
  event    Json
  prevHash String
  hash     String   @unique

  @@id([shop, seq])
}

// Products the merchant lets GuardBuy restock. Nothing is ever bought for a variant that isn't managed.
model ManagedProduct {
  shop      String
  variantId String // Shopify numeric variant id
  sku       String?
  title     String
  managed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@id([shop, variantId])
}

// The merchant's suppliers. GuardBuy pays them at paypalEmail; emailChangedAt records the last change
// (a changed payment address is the classic supplier-fraud move, so the policy can react to it).
model Supplier {
  shop           String
  id             String // slug, unique per shop
  name           String
  paypalEmail    String
  emailChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  products ProductSupplier[]

  @@id([shop, id])
}

// Which supplier sells which product, on terms the merchant sets.
model ProductSupplier {
  shop            String
  variantId       String
  supplierId      String
  unitPriceCents  Int
  usualQuantity   Int
  leadTimeDays    Int
  preferred       Boolean @default(false)
  note            String  @default("") // written by the supplier: untrusted, shown to the AI as data only
  simulatedPrices Boolean @default(false) // demo only: price varies ±6% by day, standing in for a live price feed

  supplier Supplier @relation(fields: [shop, supplierId], references: [shop, id], onDelete: Cascade)

  @@id([shop, variantId, supplierId])
}

// Per-shop settings the merchant controls.
model ShopSettings {
  shop               String   @id
  shareVerifyDetails Boolean  @default(false) // public verify page shows product, supplier and amount (default: hashes only)
  updatedAt          DateTime @updatedAt
}

// One payment at a time per shop: the payment module takes this lock before re-checking the rules
// and paying, so two purchases can't both pass the weekly cap or cash floor. Expires on its own if
// a server dies while holding it.
model PaymentLock {
  shop        String   @id
  holder      String
  lockedUntil DateTime
}
